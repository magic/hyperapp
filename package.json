{
  "name": "@magic/hyperapp",
  "version": "2.0.22-alpha.1",
  "description": "Fork of the tiny framework for building web interfaces. use hyperapp instead!",
  "keywords": [
    "framework",
    "frontend",
    "hyperapp",
    "vdom",
    "virtual dom"
  ],
  "homepage": "https://hyperapp.dev",
  "license": "MIT",
  "author": "Jorge Bucaran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magic/hyperapp.git"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "main": "src/index.mjs",
  "module": "src/index.mjs",
  "types": "src/hyperapp.d.mts",
  "exports": {
    ".": {
      "types": "./src/hyperapp.d.mts",
      "import": "./src/index.mjs"
    },
    "./render": {
      "import": "./src/render.mjs"
    }
  },
  "scripts": {
    "test": "t",
    "format": "f -w -e docs",
    "lint": "lint",
    "tsc": "tsc --noEmit",
    "check": "npm run tsc && npm run lint"
  },
  "devDependencies": {
    "@magic/format": "0.0.82",
    "@magic/lint": "0.0.6",
    "@magic/test": "0.3.59",
    "typescript": "npm:@typescript/typescript6"
  }
}
